rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Only authenticated tax firm staff can access customer sensitive scans
    match /private/customers/{customerId}/documents/{fileName} {
      allow read, write: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Disallow public read/write to all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
